# Copy to .env (git-ignored). The API key lives ONLY in the backend environment.
ANTHROPIC_API_KEY=sk-ant-...

# Localhost port for the HTTP + WebSocket server.
PORT=8787

# Bind address. Default 127.0.0.1 (localhost only). Non-loopback binds
# (LAN IP, 0.0.0.0, tailnet IP) REQUIRE token auth: clients must present
# AUTH_TOKEN before the WebSocket accepts anything.
HOST=127.0.0.1

# Access token for non-loopback binds. Leave unset to have one generated and
# persisted at <DATA_DIR>/auth-token on first start.
AUTH_TOKEN=

# Directory the agent operates in (per-conversation cwd). Defaults to this project dir.
WORK_DIR=

# Baseline permission mode: default | acceptEdits | plan | auto | bypassPermissions
PERMISSION_MODE=default

# Set to true to launch sessions with --dangerously-skip-permissions so the
# bypassPermissions mode can be switched on from the UI. Dangerous; only for
# throwaway/sandboxed working directories.
ALLOW_BYPASS=false

# Optional model override (e.g. claude-fable-5-1[1m] or claude-sonnet-5). Empty = engine default.
MODEL=

# Optional comma-separated tool gating, e.g. ALLOWED_TOOLS=Read,Grep,Glob
ALLOWED_TOOLS=
DISALLOWED_TOOLS=

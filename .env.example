# Copy to .env (git-ignored). The API key lives ONLY in the backend environment.
ANTHROPIC_API_KEY=sk-ant-...

# Localhost port for the HTTP + WebSocket server.
PORT=8787

# Bind address. Default 127.0.0.1 (localhost only). Setting a LAN IP or
# 0.0.0.0 exposes an UNAUTHENTICATED agent that can run shell commands and
# spend your API key to everyone on that network — prefer an SSH tunnel.
HOST=127.0.0.1

# Directory the agent operates in (per-conversation cwd). Defaults to this project dir.
WORK_DIR=

# Baseline permission mode: default | acceptEdits | plan | auto | bypassPermissions
PERMISSION_MODE=default

# Set to true to launch sessions with --dangerously-skip-permissions so the
# bypassPermissions mode can be switched on from the UI. Dangerous; only for
# throwaway/sandboxed working directories.
ALLOW_BYPASS=false

# Optional model override (e.g. claude-sonnet-5). Empty = engine default.
MODEL=

# Optional comma-separated tool gating, e.g. ALLOWED_TOOLS=Read,Grep,Glob
ALLOWED_TOOLS=
DISALLOWED_TOOLS=
